{
  "name": "pht-mastertool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/verify-dist-leads.mjs",
    "preview": "vite preview",
    "bulk:ingest": "node scripts/run-all-bulk-jobs.mjs",
    "bulk:opentender": "node scripts/bulk-ingest-opentender.mjs",
    "bulk:ireland": "node scripts/bulk-ingest-ireland.mjs",
