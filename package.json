    "test:probability": "node scripts/test-tender-probability.mjs",
    "test:pipeline": "node scripts/test-tender-pipeline.mjs",
    "build:dach-leads": "node scripts/build-dach-leads.mjs",
    "discover:customers": "node scripts/daily-customer-discovery.mjs --geocode",
    "enrich:contacts": "node scripts/enrich-customer-contacts.mjs",
    "setup:production": "node scripts/setup-production.mjs",
    "setup:supabase": "node scripts/apply-supabase-schema.mjs",
    "setup:vercel-env": "node scripts/sync-vercel-env.mjs",
