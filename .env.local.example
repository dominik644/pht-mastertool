# App-Login (PHT Mastertool – getrennt von Microsoft Graph)
# APP_SESSION_SECRET=min-32-chars-random-string
# APP_ADMIN_EMAIL=weller@pht.group
# APP_USERS=[{"email":"weller@pht.group","password":"IhrSicheresPasswort","name":"Dominik Weller","admin":true}]
# Optional: Supabase app_users-Tabelle für Benutzerverwaltung in Einstellungen → Zugänge

# Microsoft Azure AD (MSAL) – Outlook Kalender & To Do für weller@pht.group
# App-Registrierung: https://portal.azure.com → App registrations → SPA
# Redirect URI: http://localhost:5173 und https://pht-mastertool.vercel.app
# API Permissions: Calendars.ReadWrite, Tasks.ReadWrite, User.Read (delegated)
VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=your-pht-tenant-id-or-common
VITE_MS_DEFAULT_USER=weller@pht.group

# SOPHIE KI-Assistentin (OpenAI – nur Server/Vercel, NICHT VITE_ prefix!)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Vergabeportale – nur Server/Vercel (NICHT VITE_ prefix!)
# Doffin Norwegen (Public API v2 – Lesen/Suchen):
# 1. https://dof-notices-prod-api.developer.azure-api.net/ → Sign up
# 2. Products → „Public API“ abonnieren (NICHT eSender/notices Publish-API)
# 3. Profile → Subscriptions → Primary key kopieren
DOFFIN_API_KEY=your-doffin-public-api-subscription-key
# HILMA Finnland: https://hns-hilma-prod-apim.developer.azure-api.net/ → avp-read
HILMA_API_KEY=your-hilma-subscription-key
# Chile Mercado Público: https://api.mercadopublico.cl → „Participa“ (Clave Única, ~2 Werktage)
MERCADOPUBLICO_TICKET=your-mercado-publico-api-ticket
# TenderNed Niederlande XML-API (HTTP Basic Auth – Zugang via functioneelbeheer@tenderned.nl)
# Listing (TNS JSON) ist öffentlich; XML-Detail für CPV-Codes benötigt diese Credentials.
TENDERNED_API_USERNAME=your-tenderned-api-username
TENDERNED_API_PASSWORD=your-tenderned-api-password

# Phase B – geplanter Ingest (/api/ingest, Vercel Cron täglich 06:00 UTC)
# Hobby-Plan: max. 1×/Tag (kein */6). Für 6h-Intervall: Pro oder externer Scheduler.
CRON_SECRET=your-random-cron-secret
# Optional – Supabase-Bulk-Speicher (schema: supabase/schema.sql)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Frontend-Lesung via /api/tenders-db (anon key reicht mit RLS read policy)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Vertrieb: sales_feedback + customer_visits (Dual-Write via /api/sales-sync, schema ab Zeile 77)

# Kunden-Terminvorschläge (Self-Scheduling per E-Mail-Link)
# SCHEDULE_TOKEN_SECRET=random-secret-min-32-chars  (npm run setup:production generiert Hinweis)
# Optional: SUPABASE_DB_URL=postgresql://... für automatisches Schema (scripts/apply-supabase-schema.mjs)
# RESEND_API_KEY=re_...  (empfohlen – https://resend.com; ohne Key: E-Mail-Vorschau in der App)
# RESEND_FROM=PHT Terminplanung <termin@pht.group>
# SCHEDULE_EMAIL_FROM=PHT Terminplanung <termin@pht.group>
# SCHEDULE_PUBLIC_BASE_URL=https://pht-mastertool.vercel.app
# SCHEDULE_SALES_NOTIFY_EMAIL=weller@pht.group
# Alternativ zu Resend: MS Graph App-only (siehe INGEST_ALERT_* oben)

# PHT Homepage – einmaliger Produktterm-Abruf (Server/Ingest, optional)
# PHT_HOMEPAGE_URL=https://pht.group
INGEST_ALERT_EMAIL=weller@pht.group
# Microsoft Graph App-only für Server-Mail (Mail.Send application permission):
# MS_GRAPH_CLIENT_ID=your-app-client-id
# MS_GRAPH_CLIENT_SECRET=your-app-secret
# MS_GRAPH_TENANT_ID=your-tenant-id
# MS_GRAPH_CALENDAR_USER=weller@pht.group
# Kalender-Berechtigung: Calendars.Read (Application) für App-only Free/Busy
# INGEST_ALERT_FROM=weller@pht.group

# Business Central OData API v2.0 (nur Server/Vercel – NICHT VITE_ prefix!)
# Azure App-Registrierung mit „Dynamics 365 Business Central“ → API.ReadWrite.All (Application)
# BC_ENVIRONMENT = z. B. Production oder Sandbox-Name aus BC-Admin
# BC_COMPANY_ID = GUID der Firma (GET .../api/v2.0/companies)
BC_TENANT_ID=your-azure-tenant-id
BC_CLIENT_ID=your-bc-app-client-id
BC_CLIENT_SECRET=your-bc-app-client-secret
BC_ENVIRONMENT=Production
BC_COMPANY_ID=your-bc-company-guid
# Optional – Konditionsvereinbarungen (Custom-BC-API, kein Standard-v2.0-Entity):
# BC_CONDITION_AGREEMENTS_ENTITY=konditionsvereinbarungen
# BC_CUSTOM_API_PUBLISHER=pht
# BC_CUSTOM_API_GROUP=integration
# BC_CUSTOM_API_VERSION=v1.0
# BC_COMPANY_NAME=Ihre Firma GmbH
# BC_GEBIETSAUFTEILUNG_ENTITY=gebietsaufteilungen
